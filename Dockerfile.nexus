FROM node:25-alpine AS base

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache libc6-compat git python3 make g++ sqlite

# Install dependencies and build the production application.
COPY . .
RUN npm ci --include=optional --legacy-peer-deps
RUN npm run build

# Environment variables
ENV PORT=20129
ENV HOSTNAME="0.0.0.0"
ENV HOST="0.0.0.0"
ENV NODE_ENV=production

EXPOSE 20129

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:20129/livez').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["npm", "run", "start"]
